{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/IdentityResponse",
  "title": "IdentityResponse",
  "type": "object",
  "properties": {
    "status": {
      "type": "integer",
      "enum": [
        0,
        1
      ],
      "description": "1 for success, 0 for failure"
    },
    "error": {
      "type": "string",
      "description": "Error message if status is 0"
    }
  }
}