{
  "opencollection": "1.0.0",
  "info": {
    "name": "Mixpanel Data Pipelines API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Pipelines",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Mixpanel List pipelines",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://data.mixpanel.com/api/2.0/nessie/pipeline/list",
            "params": [
              {
                "name": "project_id",
                "value": "",
                "type": "query",
                "description": "The Mixpanel project ID"
              }
            ]
          },
          "docs": "Retrieve a list of all data export pipelines configured for the project."
        },
        {
          "info": {
            "name": "Mixpanel Create a pipeline",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://data.mixpanel.com/api/2.0/nessie/pipeline/create",
            "params": [
              {
                "name": "project_id",
                "value": "",
                "type": "query",
                "description": "The Mixpanel project ID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a new data export pipeline to continuously export Mixpanel data to a cloud storage destination such as BigQuery, Snowflake, S3, or GCS."
        },
        {
          "info": {
            "name": "Mixpanel Update a pipeline",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://data.mixpanel.com/api/2.0/nessie/pipeline/update",
            "params": [
              {
                "name": "project_id",
                "value": "",
                "type": "query",
                "description": "The Mixpanel project ID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update the configuration of an existing data export pipeline."
        },
        {
          "info": {
            "name": "Mixpanel Delete a pipeline",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://data.mixpanel.com/api/2.0/nessie/pipeline/delete",
            "params": [
              {
                "name": "project_id",
                "value": "",
                "type": "query",
                "description": "The Mixpanel project ID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Delete a data export pipeline by ID."
        },
        {
          "info": {
            "name": "Mixpanel Pause a pipeline",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://data.mixpanel.com/api/2.0/nessie/pipeline/pause",
            "params": [
              {
                "name": "project_id",
                "value": "",
                "type": "query",
                "description": "The Mixpanel project ID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Pause an active data export pipeline."
        },
        {
          "info": {
            "name": "Mixpanel Resume a pipeline",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://data.mixpanel.com/api/2.0/nessie/pipeline/unpause",
            "params": [
              {
                "name": "project_id",
                "value": "",
                "type": "query",
                "description": "The Mixpanel project ID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Resume a previously paused data export pipeline."
        }
      ]
    },
    {
      "info": {
        "name": "Pipeline Runs",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Mixpanel List pipeline runs",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://data.mixpanel.com/api/2.0/nessie/pipeline/runs",
            "params": [
              {
                "name": "project_id",
                "value": "",
                "type": "query",
                "description": "The Mixpanel project ID"
              },
              {
                "name": "id",
                "value": "",
                "type": "query",
                "description": "Pipeline ID"
              }
            ]
          },
          "docs": "Retrieve the execution history for a specific pipeline."
        }
      ]
    }
  ],
  "bundled": true
}