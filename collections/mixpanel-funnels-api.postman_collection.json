      "item": [
        {
          "id": "129d5975-6cee-4480-acf0-e6e801c33085",
          "name": "Mixpanel Query funnel data",
          "request": {
            "name": "Mixpanel Query funnel data",
            "description": {
              "content": "Query funnel conversion data for a defined sequence of events. Returns conversion rates and counts at each step.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "funnels"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "project_id",
                  "value": "<integer>",
                  "description": "(Required) The Mixpanel project ID"
                },
                {
                  "disabled": false,
                  "key": "funnel_id",
                  "value": "<integer>",
                  "description": "(Required) The ID of the funnel to query"
                },
                {
                  "disabled": false,
                  "key": "from_date",
                  "value": "<date>",
                  "description": "(Required) Start date (YYYY-MM-DD)"
                },
                {
                  "disabled": false,
                  "key": "to_date",
                  "value": "<date>",
                  "description": "(Required) End date (YYYY-MM-DD)"
                },
                {
                  "disabled": false,
                  "key": "length",
                  "value": "<integer>",
                  "description": "Number of units in the conversion window"
                },
                {
                  "disabled": false,
                  "key": "length_unit",
                  "value": "<string>",
                  "description": "Unit of time for the conversion window"
                },
                {
                  "disabled": false,
                  "key": "interval",
                  "value": "<integer>",
                  "description": "Number of days per data point"
                },
                {
                  "disabled": false,
                  "key": true,
                  "value": "<string>",
                  "description": "Property expression to segment results"
                },
                {
                  "disabled": false,
                  "key": "where",
                  "value": "<string>",
                  "description": "Expression to filter events"
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "<integer>",
                  "description": "Maximum number of segment values to return"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
