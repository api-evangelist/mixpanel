        {
          "id": "b2ef2285-fb2c-4f36-87ca-d5c601cf52eb",
          "name": "Mixpanel Import events",
          "request": {
            "name": "Mixpanel Import events",
            "description": {
              "content": "Import events into Mixpanel. Designed for high-throughput historical data import. Supports up to 2000 events per batch. Events can have timestamps in the past.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "import"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "strict",
                  "value": "<integer>",
                  "description": "When set to 1, validates all properties and rejects the entire batch if any event is invalid"
                },
                {
                  "disabled": false,
                  "key": "project_id",
                  "value": "<string>",
                  "description": "The project ID to import events into"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{basicAuthUsername}}"
                },
                {
                  "key": "password",
                  "value": "{{basicAuthPassword}}"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "[\n  {\n    \"event\": \"<string>\",\n    \"properties\": {\n      \"distinct_id\": \"<string>\",\n      \"time\": \"<integer>\",\n      \"$insert_id\": \"<string>\",\n      \"token\": \"<string>\"\n    }\n  },\n  {\n    \"event\": \"<string>\",\n    \"properties\": {\n      \"distinct_id\": \"<string>\",\n      \"time\": \"<integer>\",\n      \"$insert_id\": \"<string>\",\n      \"token\": \"<string>\"\n    }\n  }\n]",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
