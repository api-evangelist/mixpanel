{
  "opencollection": "1.0.0",
  "info": {
    "name": "Mixpanel Annotations Cohorts API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Cohorts",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Mixpanel List cohorts",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://mixpanel.com/api/app/cohorts/list",
            "params": [
              {
                "name": "project_id",
                "value": "",
                "type": "query",
                "description": "The Mixpanel project ID"
              }
            ]
          },
          "docs": "Retrieve a list of all cohorts defined in the project."
        }
      ]
    }
  ],
  "bundled": true
}